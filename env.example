# ==============================================================
# SUPABASE CORE CONFIGURATION
# Backend services, authentication, database, and storage
# ==============================================================

# ==============================================================
# EVALUATION CONCURRENCY
# Max evaluations (OCR / essay / precis / outline) processed at
# once on this container. Extra jobs queue (status stays PENDING)
# until a slot frees, so several PCs running bulk line up instead
# of overwhelming the box. Raise it on a bigger container.
# ==============================================================
MAX_CONCURRENT_EVALS=6
